<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOTELUX - Reset Password</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="login-bg">
    <div class="login-container">
        <!-- Left Side: Hero Brand Section -->
        <div class="login-left-hero">
            <div class="brand-content">
                <div class="brand-logo-box">
                    <img src="/images/hotel-icon.png" alt="Hotelux Logo">
                </div>
                <h1 class="brand-name">HOTELUX</h1>
                <p class="brand-subtitle">Secure Your Hospitality Experience</p>
                <div style="margin-top: 20px;">
                    <i class="fas fa-shield-alt" style="font-size: 80px; color: rgba(99, 102, 241, 0.2);"></i>
                </div>
            </div>
        </div>

        <!-- Right Side: Forgot Password Form -->
        <div class="login-right-form">
            <div class="login-wrapper">
                <form action="/auth/forgot-password" method="POST" class="login-form">
                    <h1 style="font-size: 28px; margin-bottom: 8px; color: #fff;">Forgot Password?</h1>
                    <p style="color: #94a3b8; margin-bottom: 32px; font-size: 15px;">Enter your email and we'll send you
                        instructions to reset your password.</p>

                    <% if (locals.error && error.length> 0) { %>
                        <div class="alert alert-danger"
                            style="color: #ff4d4d; margin-bottom: 20px; font-size: 0.9rem; text-align: center; background: rgba(255, 77, 77, 0.1); padding: 12px; border-radius: 8px;">
                            <%= error %>
                        </div>
                        <% } %>
                            <% if (locals.success && success.length> 0) { %>
                                <div class="alert alert-success"
                                    style="color: #10b981; margin-bottom: 20px; font-size: 0.9rem; text-align: center; background: rgba(16, 185, 129, 0.1); padding: 12px; border-radius: 8px;">
                                    <%= success %>
                                </div>
                                <% } %>

                                    <div class="input-group">
                                        <label>Email Address</label>
                                        <div class="input-wrapper">
                                            <i class="fas fa-envelope"></i>
                                            <input type="email" name="email" placeholder="Enter your registered email"
                                                required>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-full btn-lg"
                                        style="margin-top: 10px;">
                                        Send Reset Link <i class="fas fa-paper-plane"></i>
                                    </button>

                                    <p class="auth-footer-text" style="margin-top: 24px;">
                                        Remembered it? <a href="/login" style="color: #3b82f6; font-weight: 500;">Back
                                            to Login</a>
                                    </p>
                </form>

                <p class="copyright-text" style="margin-top: 32px; color: #64748b; font-size: 13px;">© 2024 Hotelux.
                    Online Hotel Management System</p>
            </div>
        </div>
    </div>
</body>

</html>