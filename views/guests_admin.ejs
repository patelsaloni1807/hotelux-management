<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOTELUX - Guests</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Guest Page Specific Styles */
        .guest-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 12px;
            /* Row spacing */
        }

        .guest-table th {
            text-align: left;
            padding: 12px 16px;
            color: #a0aec0;
            font-size: 13px;
            text-transform: uppercase;
            font-weight: 600;
            border-bottom: 1px solid #2d3748;
        }

        .guest-table td {
            background: #1a2236;
            padding: 16px;
            color: #fff;
            border-top: 1px solid #2d3748;
            border-bottom: 1px solid #2d3748;
        }

        .guest-table tr td:first-child {
            border-left: 1px solid #2d3748;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        .guest-table tr td:last-child {
            border-right: 1px solid #2d3748;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }

        .status-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            display: inline-block;
        }

        .status-badge.checked-in {
            background: rgba(72, 187, 120, 0.2);
            color: #48bb78;
        }

        .status-badge.reserved {
            background: rgba(66, 153, 225, 0.2);
            color: #4299e1;
        }

        .status-badge.checked-out {
            background: rgba(160, 174, 192, 0.2);
            color: #a0aec0;
        }

        .status-badge.inactive {
            background: rgba(255, 255, 255, 0.1);
            color: #718096;
        }

        .action-icon {
            color: #3b82f6;
            /* Blue for view */
            margin-right: 12px;
            cursor: pointer;
            text-decoration: none;
            font-size: 16px;
        }

        .action-icon.edit {
            color: #f59e0b;
        }

        /* Orange for edit */
        .action-icon.delete {
            color: #ef4444;
        }

        /* Red for delete */
    </style>
</head>

<body class="dashboard-bg">
    <%- include('partials/sidebar_admin') %>
        <main class="dashboard-main">
            <section class="dashboard-header"
                style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Guests</h2>
                    <p>Manage guest records</p>
                </div>
                <button class="btn btn-primary" style="border-radius: 8px;">+ Add Guest</button>
            </section>

            <!-- Search Bar -->
            <section class="filters-container">
                <input type="text" placeholder="Search by name or guest ID..." class="search-input"
                    style="width: 100%; max-width: 400px;">
            </section>

            <!-- Guests Table -->
            <section class="dashboard-table">
                <table class="guest-table">
                    <thead>
                        <tr>
                            <th>Guest ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Nationality</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (guests && guests.length> 0) { %>
                            <% guests.forEach(guest=> { %>
                                <tr>
                                    <td>
                                        <%= guest.guestId %>
                                    </td>
                                    <td>
                                        <%= guest.name || 'N/A' %>
                                    </td>
                                    <td>
                                        <%= guest.email %>
                                    </td>
                                    <td>
                                        <%= guest.phone || 'N/A' %>
                                    </td>
                                    <td>
                                        <%= guest.nationality || 'N/A' %>
                                    </td>
                                    <td>
                                        <% let statusClass='inactive' ; if (guest.status==='Checked In' )
                                            statusClass='checked-in' ; else if (guest.status==='Reserved' )
                                            statusClass='reserved' ; else if (guest.status==='Checked Out' )
                                            statusClass='checked-out' ; %>
                                            <span class="status-badge <%= statusClass %>">
                                                <%= guest.status %>
                                            </span>
                                    </td>
                                    <td>
                                        <!-- View Icon (Eye) -->
                                        <a href="#" class="action-icon" title="View">👁️</a>
                                        <!-- Edit Icon (Pencil) -->
                                        <a href="#" class="action-icon edit" title="Edit">✏️</a>
                                        <!-- Delete Icon (Trash) -->
                                        <form action="#" method="POST" onsubmit="return confirm('Delete Guest?');"
                                            style="display:inline;">
                                            <button type="submit" class="action-icon delete"
                                                style="background:none; border:none; padding:0;">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" style="text-align: center;">No guests found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </section>
        </main>
</body>

</html>