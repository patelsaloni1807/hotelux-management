<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOTELUX - Change Password</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="dashboard-bg">
    <% if (user.role==='admin' ) { %>
        <%- include('partials/sidebar_admin') %>
            <% } else { %>
                <%- include('partials/sidebar_guest') %>
                    <% } %>

                        <main class="dashboard-main">
                            <section class="dashboard-header">
                                <h2>Security Settings</h2>
                                <p>Update your account password to stay secure.</p>
                            </section>

                            <div class="form-container" style="max-width: 500px; margin: 0 auto;">
                                <form action="/auth/change-password" method="POST">
                                    <h3 style="margin-bottom: 24px; color: #fff;"><i class="fas fa-key"
                                            style="color: #6366f1; margin-right: 10px;"></i> Change Password</h3>

                                    <% if (locals.error && error.length> 0) { %>
                                        <div class="alert alert-danger"
                                            style="margin-bottom: 20px; color: #ff4d4d; background: rgba(255, 77, 77, 0.1); padding: 12px; border-radius: 8px;">
                                            <%= error %>
                                        </div>
                                        <% } %>
                                            <% if (locals.success && success.length> 0) { %>
                                                <div class="alert alert-success"
                                                    style="margin-bottom: 20px; color: #10b981; background: rgba(16, 185, 129, 0.1); padding: 12px; border-radius: 8px;">
                                                    <%= success %>
                                                </div>
                                                <% } %>

                                                    <div class="input-group">
                                                        <label>Current Password</label>
                                                        <div class="input-wrapper">
                                                            <i class="fas fa-lock-open"></i>
                                                            <input type="password" name="currentPassword"
                                                                placeholder="Enter current password" required>
                                                        </div>
                                                    </div>

                                                    <div class="input-group">
                                                        <label>New Password</label>
                                                        <div class="input-wrapper">
                                                            <i class="fas fa-shield-alt"></i>
                                                            <input type="password" name="newPassword"
                                                                placeholder="Min. 6 characters" required>
                                                        </div>
                                                    </div>

                                                    <div class="input-group">
                                                        <label>Confirm New Password</label>
                                                        <div class="input-wrapper">
                                                            <i class="fas fa-check-double"></i>
                                                            <input type="password" name="confirmPassword"
                                                                placeholder="Repeat new password" required>
                                                        </div>
                                                    </div>

                                                    <div style="margin-top: 32px; display: flex; gap: 16px;">
                                                        <button type="submit" class="btn btn-primary"
                                                            style="flex: 1; padding: 14px;">Update Password</button>
                                                        <a href="/settings" class="btn btn-outline"
                                                            style="flex: 1; padding: 14px; text-align: center;">Cancel</a>
                                                    </div>
                                </form>
                            </div>
                        </main>
</body>

</html>