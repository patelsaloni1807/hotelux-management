<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOTELUX - Admin Profile</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="dashboard-bg">
    <%- include('partials/sidebar_admin') %>

        <main class="dashboard-main">
            <header class="dashboard-header">
                <h2>Admin Profile</h2>
                <p>View and manage your administrator account details</p>
            </header>

            <div class="booking-grid">
                <!-- Personal Info Card -->
                <div class="booking-card">
                    <h3 style="color: #ffbe0b; margin-bottom: 24px;">
                        <i class="fas fa-user-shield"></i> Administrator Details
                    </h3>
                    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
                        <span class="user-circle admin"
                            style="width: 80px; height: 80px; line-height: 80px; font-size: 32px;">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </span>
                        <div>
                            <div style="font-size: 24px; font-weight: bold; color: #fff;">
                                <%= user.name %>
                            </div>
                            <div
                                style="color: #ffbe0b; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">
                                System Administrator</div>
                        </div>
                    </div>

                    <div class="booking-info-item" style="margin-bottom: 16px;">
                        <span>Email Address</span>
                        <div style="color: #fff;">
                            <%= user.email %>
                        </div>
                    </div>
                    <div class="booking-info-item" style="margin-bottom: 16px;">
                        <span>Phone Number</span>
                        <div style="color: #fff;">
                            <%= user.phone || 'N/A' %>
                        </div>
                    </div>
                    <div class="booking-info-item">
                        <span>Account Created</span>
                        <div style="color: #fff;">
                            <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'N/A' %>
                        </div>
                    </div>
                </div>

                <!-- System Access Card -->
                <div class="booking-card">
                    <h3 style="color: #3b82f6; margin-bottom: 24px;">
                        <i class="fas fa-key"></i> System Permissions
                    </h3>
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <div
                            style="background: rgba(59, 130, 246, 0.1); padding: 12px; border-radius: 8px; display: flex; align-items: center; gap: 12px;">
                            <i class="fas fa-check-circle" style="color: #3b82f6;"></i>
                            <span style="font-size: 14px;">Full CRUD Access (Rooms)</span>
                        </div>
                        <div
                            style="background: rgba(59, 130, 246, 0.1); padding: 12px; border-radius: 8px; display: flex; align-items: center; gap: 12px;">
                            <i class="fas fa-check-circle" style="color: #3b82f6;"></i>
                            <span style="font-size: 14px;">Guest Management Access</span>
                        </div>
                        <div
                            style="background: rgba(59, 130, 246, 0.1); padding: 12px; border-radius: 8px; display: flex; align-items: center; gap: 12px;">
                            <i class="fas fa-check-circle" style="color: #3b82f6;"></i>
                            <span style="font-size: 14px;">Booking Oversight Access</span>
                        </div>
                        <div
                            style="background: rgba(59, 130, 246, 0.1); padding: 12px; border-radius: 8px; display: flex; align-items: center; gap: 12px;">
                            <i class="fas fa-check-circle" style="color: #3b82f6;"></i>
                            <span style="font-size: 14px;">Financial Report Access</span>
                        </div>
                    </div>
                    <button class="login-btn"
                        style="margin-top: 24px; background: rgba(59, 130, 246, 0.2); color: #3b82f6; border: 1px solid #3b82f6;">View
                        Security Logs</button>
                </div>

                <!-- System Activity Stat -->
                <div class="booking-card">
                    <h3 style="color: #10b981; margin-bottom: 24px;">
                        <i class="fas fa-chart-line"></i> Recent Activity
                    </h3>
                    <div class="booking-info-item" style="margin-bottom: 20px;">
                        <span>Last Login</span>
                        <div style="color: #fff;">Today, 10:45 AM</div>
                    </div>
                    <div class="booking-info-item" style="margin-bottom: 20px;">
                        <span>Recent Actions</span>
                        <div style="font-size: 13px; color: #a0aec0; margin-top: 8px;">
                            <div style="margin-bottom: 8px;"><i class="fas fa-plus" style="margin-right: 8px;"></i>
                                Added Room 302</div>
                            <div style="margin-bottom: 8px;"><i class="fas fa-edit" style="margin-right: 8px;"></i>
                                Updated Room 101 Price</div>
                            <div><i class="fas fa-user-check" style="margin-right: 8px;"></i> Confirmed Booking #AX782
                            </div>
                        </div>
                    </div>
                    <button class="login-btn" style="margin-top: 10px;">Edit Profile</button>
                </div>
            </div>
        </main>
</body>

</html>