<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOTELUX - Register</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="login-bg">
    <div class="login-container">
        <!-- Left Side: Hero Brand Section -->
        <div class="login-left-hero">
            <div class="brand-content">
                <div class="brand-logo-box">
                    <img src="/images/hotel-icon.png" alt="Hotelux Logo">
                </div>
                <h1 class="brand-name">HOTELUX</h1>
                <p class="brand-subtitle">Online Hotel Management System</p>

                <ul class="brand-features">
                    <li><i class="fas fa-check-circle" style="color: #48bb78;"></i> Manage room bookings efficiently
                    </li>
                    <li><i class="fas fa-check-circle" style="color: #6366f1;"></i> Track guests and reservations</li>
                    <li><i class="fas fa-check-circle" style="color: #f6ad55;"></i> Generate billing reports instantly
                    </li>
                </ul>
            </div>
        </div>

        <!-- Right Side: Register Form -->
        <div class="login-right-form">
            <div class="login-wrapper">
                <form action="/register" method="POST" class="login-form">
                    <h1 style="font-size: 28px; margin-bottom: 8px; color: #fff;">Create Account</h1>
                    <p style="color: #94a3b8; margin-bottom: 32px; font-size: 16px;">Join us to experience luxury stays
                    </p>

                    <% if (locals.error && error.length> 0) { %>
                        <div class="alert alert-danger"
                            style="color: #ff4d4d; margin-bottom: 20px; font-size: 0.9rem; text-align: center; background: rgba(255, 77, 77, 0.1); padding: 12px; border-radius: 8px;">
                            <%= error %>
                        </div>
                        <% } %>

                            <div class="input-group">
                                <label>Full Name</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-user-tag"></i>
                                    <input type="text" name="name" placeholder="Enter your full name" required>
                                </div>
                            </div>

                            <div class="input-group">
                                <label>Email Address</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-envelope"></i>
                                    <input type="email" name="email" placeholder="Enter your email" required>
                                </div>
                            </div>

                            <div class="input-group">
                                <label>Create Password</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-lock"></i>
                                    <input type="password" name="password" placeholder="Min. 6 characters" required>
                                </div>
                            </div>

                            <div class="input-group">
                                <label>Phone Number</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-phone"></i>
                                    <input type="text" name="phone" placeholder="Enter phone number">
                                </div>
                            </div>

                            <div class="input-group" style="margin-bottom: 32px;">
                                <label>Nationality</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-globe"></i>
                                    <input type="text" name="nationality" placeholder="Enter your country">
                                </div>
                            </div>

                            <button type="submit" class="login-btn-large">
                                Create Account <i class="fas fa-paper-plane"></i>
                            </button>

                            <p class="auth-footer-text">
                                Already have an account? <a href="/login"
                                    style="color: #3b82f6; font-weight: 500;">Login here</a>
                            </p>
                </form>

                <p class="copyright-text" style="margin-top: 32px; color: #64748b; font-size: 13px;">© 2024 Hotelux.
                    Online Hotel Management System</p>
            </div>
        </div>
    </div>
</body>

</html>