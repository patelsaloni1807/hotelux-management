<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOTELUX - My Profile</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="website-bg">
    <%- include('partials/navbar_guest') %>

        <main class="website-main" style="max-width: 1000px; margin: 40px auto; padding: 0 20px;">
            <header class="text-center" style="margin-bottom: 48px;">
                <h1 style="font-size: 32px; margin-bottom: 8px;">My Profile</h1>
                <p style="color: #94a3b8;">Manage your personal account and stay preferences</p>
            </header>

            <div class="booking-grid"
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
                <!-- Profile Info Card -->
                <div class="booking-card">
                    <h3 style="color: #6366f1; margin-bottom: 24px;">
                        <i class="fas fa-user-circle"></i> Account Information
                    </h3>
                    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
                        <span class="user-circle guest"
                            style="width: 70px; height: 70px; line-height: 70px; font-size: 28px;">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </span>
                        <div>
                            <div style="font-size: 22px; font-weight: bold; color: #fff;">
                                <%= user.name %>
                            </div>
                            <div style="color: #6366f1; font-size: 14px;">Member since <%= user.createdAt ? new
                                    Date(user.createdAt).toLocaleDateString() : '2024' %>
                            </div>
                        </div>
                    </div>

                    <div class="booking-info-item" style="margin-bottom: 16px;">
                        <span style="color: #94a3b8; font-size: 13px; display: block; margin-bottom: 4px;">Email
                            Address</span>
                        <div style="color: #fff; font-size: 16px;">
                            <%= user.email %>
                        </div>
                    </div>
                    <div class="booking-info-item" style="margin-bottom: 16px;">
                        <span style="color: #94a3b8; font-size: 13px; display: block; margin-bottom: 4px;">Phone
                            Number</span>
                        <div style="color: #fff; font-size: 16px;">
                            <%= user.phone || 'Not provided' %>
                        </div>
                    </div>
                    <div class="booking-info-item">
                        <span
                            style="color: #94a3b8; font-size: 13px; display: block; margin-bottom: 4px;">Nationality</span>
                        <div style="color: #fff; font-size: 16px;">
                            <%= user.nationality || 'Not specified' %>
                        </div>
                    </div>
                </div>

                <!-- Loyalty Status -->
                <div class="booking-card" style="position: relative; overflow: hidden;">
                    <h3 style="color: #f6ad55; margin-bottom: 24px;">
                        <i class="fas fa-gem"></i> Member Rewards
                    </h3>
                    <div
                        style="background: rgba(246, 173, 85, 0.1); padding: 20px; border-radius: 16px; margin-bottom: 24px; border: 1px solid rgba(246, 173, 85, 0.2);">
                        <div
                            style="color: #f6ad55; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">
                            Current Tier</div>
                        <div style="font-size: 24px; font-weight: 800; color: #fff; margin: 4px 0;">Gold Member</div>
                        <div style="color: #94a3b8; font-size: 14px;">350 Points available</div>
                    </div>

                    <div class="booking-info-item">
                        <span style="color: #94a3b8; font-size: 13px;">Progress to Platinum</span>
                        <div
                            style="height: 8px; background: rgba(255,255,255,0.05); border-radius: 4px; margin-top: 10px;">
                            <div
                                style="width: 65%; height: 100%; background: linear-gradient(90deg, #f6ad55, #ed8936); border-radius: 4px;">
                            </div>
                        </div>
                    </div>

                    <button class="login-btn"
                        style="margin-top: 32px; background: rgba(246, 173, 85, 0.1); color: #f6ad55; border: 1px solid #f6ad55;">View
                        My Benefits</button>
                </div>

                <!-- Settings/Quick Links -->
                <div class="booking-card">
                    <h3 style="color: #10b981; margin-bottom: 24px;">
                        <i class="fas fa-cog"></i> Account Actions
                    </h3>
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <a href="/dashboard/my-bookings"
                            style="text-decoration: none; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.03); padding: 16px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); transition: all 0.2s; color: #fff;">
                            <span><i class="fas fa-calendar-alt" style="margin-right: 12px; color: #10b981;"></i>
                                Current Bookings</span>
                            <i class="fas fa-chevron-right" style="font-size: 12px; color: #4a5568;"></i>
                        </a>
                        <a href="/dashboard/history"
                            style="text-decoration: none; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.03); padding: 16px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); transition: all 0.2s; color: #fff;">
                            <span><i class="fas fa-history" style="margin-right: 12px; color: #10b981;"></i> Past
                                Stays</span>
                            <i class="fas fa-chevron-right" style="font-size: 12px; color: #4a5568;"></i>
                        </a>
                        <a href="/logout"
                            style="text-decoration: none; display: flex; align-items: center; justify-content: space-between; background: rgba(239, 68, 68, 0.05); padding: 16px; border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.1); transition: all 0.2s; color: #ef4444;">
                            <span><i class="fas fa-sign-out-alt" style="margin-right: 12px;"></i> Logout</span>
                        </a>
                    </div>
                    <button class="login-btn" style="margin-top: 24px; padding: 14px;">Update Personal Details</button>
                </div>
            </div>
        </main>

        <style>
            .booking-card a:hover {
                background: rgba(255, 255, 255, 0.08) !important;
                transform: translateX(4px);
            }
        </style>
</body>

</html>