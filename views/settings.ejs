<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOTELUX - Settings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="dashboard-bg">
    <%- include('partials/sidebar_admin') %>
        <main class="dashboard-main">
            <section class="dashboard-header">
                <h2>Settings</h2>
                <p>Manage your account and application preferences</p>
            </section>

            <section class="profile-section" style="max-width: 100%; margin-left: 0;">
                <div class="profile-grid">
                    <div>
                        <h3>General Settings</h3>
                        <div class="input-group">
                            <label>Hotel Name</label>
                            <input type="text" name="hotelName" value="HOTELUX">
                        </div>
                        <div class="input-group">
                            <label>Currency</label>
                            <input type="text" name="currency" value="INR (₹)">
                        </div>
                    </div>
                    <div>
                        <h3>Admin Profile</h3>
                        <div class="input-group">
                            <label>Name</label>
                            <input type="text" name="name" value="<%= user.name %>">
                        </div>
                        <div class="input-group">
                            <label>Email</label>
                            <input type="email" name="email" value="<%= user.email %>">
                        </div>
                    </div>
                </div>

                <div style="margin-top: 32px;">
                    <h3>Security</h3>
                    <a href="/change-password" class="btn btn-secondary"
                        style="max-width: 250px; text-decoration: none;">Change Password</a>
                    <p style="color: #a0aec0; font-size: 14px; margin-top: 8px;">Update your login credentials regularly
                        for better security.</p>
                </div>

                <div style="margin-top: 32px; border-top: 1px solid #2d3748; padding-top: 24px;">
                    <h3 style="color: #f56565;">Danger Zone</h3>
                    <p style="color: #a0aec0; font-size: 14px;">Once you delete a record or reset data, it cannot be
                        undone.</p>
                    <button class="btn btn-danger" style="max-width: 250px; margin-top: 12px;">Reset System
                        Data</button>
                </div>
            </section>
        </main>
</body>

</html>